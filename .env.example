# =============================================================================
# Variables de Entorno - Detective de Estafas Digitales (Ejemplo sin secretos)
# =============================================================================
# Copiar este archivo a `.env` (que está ignorado por Git y por Docker) solo si
# se desea utilizar el Modo de Orquesta de Agentes IA con Google Gemini API.
# El Modo Local Determinístico NO requiere ninguna clave ni conexión a internet.

# Clave de API de Google Gemini (requerida únicamente para el Modo Agentes IA)
GEMINI_API_KEY=

# Modelo de Gemini a utilizar en el Agente Orquestador y el Agente Preparador
GEMINI_MODEL=gemini-2.5-flash

# Telemetría de diagnóstico de integridad sin PII (true / false)
DETECTIVE_DIAGNOSTICS=false
